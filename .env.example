# Copy to apps/web/.env.local for local development. Generate two different
# values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_SETUP_TOKEN=replace-with-a-different-random-setup-token
BETTER_AUTH_URL=http://localhost:3000

# Leave DATABASE_URL unset for a single-process persistent local PGlite instance.
# For production, use PostgreSQL and an HTTPS BETTER_AUTH_URL.
# DATABASE_URL=postgresql://bootstrap:password@localhost:5432/bootstrap
# BOOTSTRAP_DATA_DIR=/absolute/path/to/private/bootstrap-data

# No AI model, Composio, or billing credentials are needed for this milestone.
