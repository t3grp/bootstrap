# Copy to apps/web/.env.local for local development. Generate two different
# values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_SETUP_TOKEN=replace-with-a-different-random-setup-token
BETTER_AUTH_URL=http://localhost:3000

# Leave DATABASE_URL unset for a single-process persistent local PGlite instance.
# For production, use PostgreSQL and an HTTPS BETTER_AUTH_URL.
# DATABASE_URL=postgresql://bootstrap:password@localhost:5432/bootstrap
# BOOTSTRAP_DATA_DIR=/absolute/path/to/private/bootstrap-data

# Manual workspace features need no model credentials. Assignments are disabled
# until a provider is explicitly configured. Restart web/worker after changes.

# Deterministic local acceptance (fixture output, no AI or model charges):
# BOOTSTRAP_MODEL_PROVIDER=deterministic
# BOOTSTRAP_ENABLE_TEST_PROVIDER=true

# Live self-hosted provider (operator account; may incur provider charges):
# BOOTSTRAP_MODEL_PROVIDER=openai-compatible
# BOOTSTRAP_MODEL_BASE_URL=https://your-provider.example/v1
# BOOTSTRAP_MODEL_ID=your-model-id
# BOOTSTRAP_MODEL_API_KEY=your-server-only-provider-key

# One model step per assignment. These operator caps can only be reduced by UI/API.
# BOOTSTRAP_AGENT_MAX_INPUT_TOKENS=16000
# BOOTSTRAP_AGENT_MAX_OUTPUT_TOKENS=2048
# BOOTSTRAP_AGENT_TIMEOUT_MS=120000

# Defaults: embedded with local PGlite; external with PostgreSQL.
# BOOTSTRAP_AGENT_WORKER=external
# No Composio, billing, schedules, or provisioning is activated by this slice.
